# Supabase — copy this to .env and fill in your values
# Get these from: https://supabase.com → Your Project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Never add the service_role / secret key here: every VITE_ variable is
# published inside the website's JavaScript. Admin actions run in the
# `admin-users` Edge Function instead (see supabase/DEPLOY.md).
